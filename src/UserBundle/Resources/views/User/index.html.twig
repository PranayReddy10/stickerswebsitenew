{% extends "AppBundle::layout.html.twig" %}
{% block body %}

{# The list said "Messages list" over a table of users and offered one action.
   A name is now a link to the person, and the row says what they have made. #}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        Users
                        <span class="text-muted" style="font-size:14px;font-weight:normal;">
                            {{ (users|length) - 1 }} registered
                        </span>
                        <form method="get" class="pull-right" style="display:flex;align-items:center;">
                            <input type="text" name="q" class="form-control" placeholder="Name or email"
                                   value="{{ app.request.query.get('q') }}"
                                   style="width:220px;margin-right:8px;">
                            <button type="submit" class="btn btn-fill btn-rose btn-sm">
                                <i class="material-icons">search</i>
                            </button>
                        </form>
                    </h4>

                    <div class="table-responsive">
                        <table class="table" width="100%">
                            <thead class="text-primary">
                                <tr>
                                    <th width="60px"></th>
                                    <th>Name</th>
                                    <th>Signed up with</th>
                                    <th>State</th>
                                    <th class="text-right">Packs</th>
                                    <th width="130px" class="text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for user in pagination %}
                                <tr>
                                    <td>
                                        <img src="{{ user.image }}" alt=""
                                             style="width:38px;height:38px;border-radius:50%;object-fit:cover;background:#eceef2;">
                                    </td>
                                    <td>
                                        <a href="{{ path('user_user_view', {'id': user.id}) }}">
                                            <b>{{ user.name ?: user.username }}</b>
                                        </a><br>
                                        <span class="text-muted" style="font-size:12px;">{{ user.email }}</span>
                                    </td>
                                    <td>
                                        {% if user.type == 'facebook' %}
                                            <span class="pill pill-blue">Facebook</span>
                                        {% elseif user.type == 'google' %}
                                            <span class="pill pill-rose">Google</span>
                                        {% else %}
                                            <span class="pill pill-hollow">Email</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if user.enabled %}
                                            <span class="pill pill-green">Enabled</span>
                                        {% else %}
                                            <span class="pill pill-grey">Disabled</span>
                                        {% endif %}
                                        {% if user.trusted %}<span class="pill pill-orange">Trusted</span>{% endif %}
                                    </td>
                                    <td class="text-right">{{ user.packs|length }}</td>
                                    <td class="text-right">
                                        <a href="{{ path('user_user_view', {'id': user.id}) }}" rel="tooltip"
                                           data-placement="left" class="btn btn-primary btn-xs btn-round"
                                           data-original-title="Open">
                                            <i class="material-icons">pageview</i>
                                        </a>
                                        <a href="{{ path('user_user_edit', {'id': user.id}) }}" rel="tooltip"
                                           data-placement="left" class="btn btn-default btn-xs btn-round"
                                           data-original-title="Edit">
                                            <i class="material-icons">edit</i>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6">
                                        <br><br>
                                        <center>
                                            <img src="{{ asset('img/bg_empty.png') }}" style="width:auto !important;">
                                            <p class="text-muted" style="margin-top:14px;">Nobody found.</p>
                                        </center>
                                        <br><br>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="pull-right">
                        {{ knp_pagination_render(pagination) }}
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
