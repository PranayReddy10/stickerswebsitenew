{% extends "AppBundle::layout.html.twig" %}
{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="card">
                <div class="card-header card-header-icon" data-background-color="rose">
                    <i class="material-icons">movie</i>
                </div>
                <div class="card-content">
                    <h4 class="card-title">Add reel</h4>

                    {% if not spaces_ready %}
                        <div class="alert alert-warning">
                            <b>DigitalOcean Spaces is not configured.</b>
                            Set <code>spaces_key</code>, <code>spaces_secret</code>,
                            <code>spaces_bucket</code>, <code>spaces_region</code> and
                            <code>spaces_endpoint</code> in <code>app/config/parameters.yml</code>,
                            then clear <code>app/cache/prod</code>.
                        </div>
                    {% else %}

                    <p class="text-muted" style="font-size:12px;">
                        Uploading to <code>{{ spaces.host }}</code>.
                        Large files go straight from your browser to the Space; if the
                        browser is blocked they go via the server instead, capped at
                        <code>{{ php_post_limit }}</code>.
                    </p>

                    <p>
                        <button id="spaces-check" class="btn btn-simple btn-rose btn-sm">
                            <i class="material-icons">check_circle</i> Test Spaces connection
                        </button>
                        <span id="spaces-check-result" class="text-muted"></span>
                    </p>

                    <div class="form-group">
                        <label class="control-label">Author</label>
                        <select id="reel-user" class="form-control">
                            {% for user in users %}
                                <option value="{{ user.id }}"{% if user.id == current_user_id %} selected{% endif %}>{{ user.name }} (#{{ user.id }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Caption</label>
                        <input id="reel-caption" type="text" class="form-control" maxlength="500" />
                    </div>

                    <div class="form-group">
                        <label class="control-label">Video (mp4 / mov / webm) or photo (jpg / png / webp)</label>
                        <input id="reel-file" type="file" class="form-control"
                               accept="video/mp4,video/quicktime,video/webm,image/jpeg,image/png,image/webp" />
                    </div>

                    <div class="progress" id="reel-progress-wrap" style="display:none;">
                        <div id="reel-progress" class="progress-bar progress-bar-rose" style="width:0%"></div>
                    </div>
                    <p id="reel-status" class="text-muted"></p>

                    <span class="pull-right">
                        <a href="{{ path('app_reel_index') }}" class="btn btn-fill btn-yellow">
                            <i class="material-icons">arrow_back</i> Cancel
                        </a>
                        <button id="reel-upload" class="btn btn-fill btn-rose">UPLOAD</button>
                    </span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var button = document.getElementById('reel-upload');
    if (!button) { return; }

    var VIDEO_EXT = ['mp4', 'mov', 'webm'];
    var status = document.getElementById('reel-status');
    var progressWrap = document.getElementById('reel-progress-wrap');
    var progress = document.getElementById('reel-progress');

    function say(text) { status.textContent = text; }

    // Symfony's dev error pages are HTML; dig out the message so the real cause
    // is visible on screen instead of a wall of markup.
    function describe(text) {
        if (!text) { return '(an empty response - PHP most likely died, check the error log)'; }
        var match = text.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
        if (match) { return match[1].trim().slice(0, 300); }
        return text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 300);
    }

    function post(url, data) {
        return new Promise(function (resolve, reject) {
            var body = new FormData();
            for (var k in data) {
                // FormData stringifies whatever it is given, so a null field would
                // arrive at the server as the four letters "null" and be stored.
                if (data[k] === null || data[k] === undefined) { continue; }
                body.append(k, data[k]);
            }
            var xhr = new XMLHttpRequest();
            xhr.open('POST', url);
            xhr.onload = function () {
                var parsed;
                try { parsed = JSON.parse(xhr.responseText); }
                catch (e) {
                    // Not JSON means the server errored before reaching our code.
                    // Show what it actually said rather than swallowing it.
                    reject(new Error('Server replied with HTTP ' + xhr.status
                        + ' and this instead of JSON: ' + describe(xhr.responseText)));
                    return;
                }
                // The code lives in the body, because a 5xx status never survives
                // the CDN in front of this site.
                if (parsed.code === 200) { resolve(parsed); }
                else {
                    var failure = new Error(parsed.message || ('error ' + parsed.code));
                    failure.payload = parsed;   // keep diagnostics for the caller
                    reject(failure);
                }
            };
            xhr.onerror = function () { reject(new Error('Network error')); };
            xhr.send(body);
        });
    }

    // Direct PUT to Spaces, with the exact headers the presigned URL was signed for.
    function putToSpaces(media, file) {
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('PUT', media.url);
            for (var name in media.headers) { xhr.setRequestHeader(name, media.headers[name]); }
            xhr.upload.onprogress = function (e) {
                if (e.lengthComputable) {
                    progress.style.width = Math.round((e.loaded / e.total) * 100) + '%';
                }
            };
            xhr.onload = function () {
                if (xhr.status >= 200 && xhr.status < 300) { resolve(); }
                else {
                    reject(new Error('Spaces rejected the upload (HTTP ' + xhr.status + '). '
                        + (xhr.status === 403
                            ? 'A 403 here usually means the presigned URL expired or the '
                              + 'Spaces key lacks write access to this bucket.'
                            : xhr.responseText.slice(0, 200))));
                }
            };
            xhr.onerror = function () {
                // The browser will not tell a script why a cross-origin request failed,
                // so spell out exactly what the bucket has to allow. Nearly always this
                // is a trailing slash on the Origin, or a missing allowed header.
                var host = media.url.split('/')[2];
                reject(new Error(
                    'The browser could not PUT to ' + host + '. In your Space go to '
                    + 'Settings -> CORS Configurations and check the rule says exactly: '
                    + 'Origin ' + window.location.origin + ' (no trailing slash), '
                    + 'Methods GET and PUT, Allowed headers * '
                    + '(it must cover ' + Object.keys(media.headers).join(' and ') + ').'));
            };
            xhr.send(file);
        });
    }

    // Uploads a 2 byte object and reports what Spaces said, so a credential problem
    // is one click away instead of being inferred from a failed image upload.
    var checkButton = document.getElementById('spaces-check');
    if (checkButton) {
        checkButton.addEventListener('click', function (event) {
            event.preventDefault();
            var out = document.getElementById('spaces-check-result');
            out.textContent = ' testing...';
            function withCredentials(message, c) {
                if (!c || !c.key) { return message; }
                // Never the secret itself - just enough to spot a bad paste.
                return message + '  [key ' + c.key + ', secret ' + c.secret_length
                    + ' chars' + (c.secret_had_whitespace ? ', HAS WHITESPACE' : '')
                    + (c.secret_looks_short ? ', LOOKS TRUNCATED' : '') + ']';
            }
            post('{{ path('app_reel_admin_spaces_check') }}', {})
                .then(function (res) {
                    out.textContent = ' ' + withCredentials(res.message, res.credentials);
                })
                .catch(function (err) {
                    out.textContent = ' ' + withCredentials(err.message,
                        err.payload && err.payload.credentials);
                });
        });
    }

    button.addEventListener('click', function (event) {
        event.preventDefault();
        var file = document.getElementById('reel-file').files[0];
        if (!file) { say('Pick a file first.'); return; }

        var ext = file.name.split('.').pop().toLowerCase();
        var type = VIDEO_EXT.indexOf(ext) !== -1 ? 'video' : 'photo';
        var user = document.getElementById('reel-user').value;

        button.disabled = true;
        progressWrap.style.display = 'block';
        progress.style.width = '0%';
        say('Asking for an upload slot...');

        // Send the file through the server instead. No CORS involved, because the
        // browser is only talking to its own origin.
        /** Sends one file through our own origin and hands back the media it stored. */
        function proxyUpload(theFile, theType) {
            return new Promise(function (resolve, reject) {
                var body = new FormData();
                body.append('file', theFile);
                body.append('type', theType);
                body.append('user', user);
                var xhr = new XMLHttpRequest();
                xhr.open('POST', '{{ path('app_reel_admin_proxy_upload') }}');
                xhr.onload = function () {
                    var parsed;
                    try { parsed = JSON.parse(xhr.responseText); }
                    catch (e) { reject(new Error('Server replied with HTTP ' + xhr.status)); return; }
                    if (parsed.code === 200) { resolve(parsed.media); }
                    else { reject(new Error(parsed.message || ('error ' + parsed.code))); }
                };
                xhr.onerror = function () { reject(new Error('Network error talking to the server')); };
                xhr.send(body);
            });
        }

        /**
         * The still, sent the same way the video just went. Without this a video that
         * had to go through the server would still arrive with no thumbnail, which is
         * the case that left every row in the list showing a broken picture.
         */
        function posterViaServer() {
            if (type !== 'video') {
                return Promise.resolve();
            }
            say('Taking a still from the video...');
            return posterFrame(file).then(function (blob) {
                if (!blob) { return; }
                var jpeg = new File([blob], 'poster.jpg', {type: 'image/jpeg'});
                return proxyUpload(jpeg, 'photo').then(function (media) {
                    thumbKey = media.object_key;
                });
            }).catch(function () {
                // A missing still never stops the reel being posted.
            });
        }

        function uploadViaServer() {
            say('Browser upload was blocked, sending through the server instead...');
            progress.style.width = '0%';
            return new Promise(function (resolve, reject) {
                var body = new FormData();
                body.append('file', file);
                body.append('type', type);
                body.append('user', user);
                var xhr = new XMLHttpRequest();
                xhr.open('POST', '{{ path('app_reel_admin_proxy_upload') }}');
                xhr.upload.onprogress = function (e) {
                    if (e.lengthComputable) {
                        progress.style.width = Math.round((e.loaded / e.total) * 100) + '%';
                    }
                };
                xhr.onload = function () {
                    var parsed;
                    try { parsed = JSON.parse(xhr.responseText); }
                    catch (e) {
                        var hint = (xhr.status === 502 || xhr.status === 504)
                            ? ' That page comes from Cloudflare, not from your server, '
                              + 'which means PHP itself died or never answered - check the '
                              + 'PHP error log on the host.'
                            : '';
                        reject(new Error('Server replied with HTTP ' + xhr.status
                            + ' and this instead of JSON: ' + describe(xhr.responseText) + hint));
                        return;
                    }
                    if (parsed.code === 200) { resolve(parsed.media); }
                    else { reject(new Error(parsed.message || ('error ' + parsed.code))); }
                };
                xhr.onerror = function () { reject(new Error('Network error talking to the server')); };
                xhr.send(body);
            });
        }

        // A video needs a still to stand in for it - in the panel's list, in the app's grid
    // and on the share page. Without one the reel's own file ends up in the thumbnail's
    // place, and an <img> pointed at an MP4 is a broken picture everywhere it appears.
    // The frame is taken here, in the browser, because the server has no video tools.
    function posterFrame(videoFile) {
        return new Promise(function (resolve) {
            var video = document.createElement('video');
            var url = URL.createObjectURL(videoFile);
            var done = false;
            function give(blob) {
                if (done) { return; }
                done = true;
                URL.revokeObjectURL(url);
                resolve(blob);
            }
            video.preload = 'metadata';
            video.muted = true;
            video.playsInline = true;
            video.onloadeddata = function () {
                // A frame a moment in, so a clip that fades up is not a black square.
                try { video.currentTime = Math.min(1, (video.duration || 2) / 2); }
                catch (e) { give(null); }
            };
            video.onseeked = function () {
                try {
                    var canvas = document.createElement('canvas');
                    canvas.width = video.videoWidth || 720;
                    canvas.height = video.videoHeight || 1280;
                    canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                    canvas.toBlob(function (blob) { give(blob); }, 'image/jpeg', 0.8);
                } catch (e) { give(null); }
            };
            video.onerror = function () { give(null); };
            // A file the browser cannot decode must not hold the upload up.
            setTimeout(function () { give(null); }, 8000);
            video.src = url;
        });
    }

    // Try the browser's own upload, and fall back to the server exactly once.
        // The fallback must sit inside this function, not in a trailing .catch, or a
        // failing fallback would be retried by that .catch and upload twice.
        var thumbKey = null;

        function obtainMedia() {
            return post('{{ path('app_reel_admin_upload_url') }}',
                        {type: type, ext: ext, user: user, thumbext: 'jpg'})
                .then(function (res) {
                    say('Uploading to DigitalOcean Spaces...');
                    return putToSpaces(res.media, file)
                        .then(function () { return uploadPoster(res.thumb); })
                        .then(function () { return res.media; });
                })
                .catch(function (err) {
                    say('Direct upload failed (' + err.message + ')');
                    return uploadViaServer().then(function (media) {
                        return posterViaServer().then(function () { return media; });
                    });
                });
        }

        /** The poster is a nicety: a video that arrives without one still posts. */
        function uploadPoster(slot) {
            if (type !== 'video' || !slot) {
                return Promise.resolve();
            }
            say('Taking a still from the video...');
            return posterFrame(file).then(function (blob) {
                if (!blob) { return; }
                return putToSpaces(slot, blob).then(function () {
                    thumbKey = slot.object_key;
                });
            }).catch(function () {
                // Never let a missing still stop the upload.
            });
        }

        obtainMedia()
            .then(function (media) {
                say('Saving...');
                return post('{{ path('app_reel_admin_create') }}', {
                    user: user,
                    type: type,
                    objectkey: media.object_key,
                    thumbkey: thumbKey,
                    caption: document.getElementById('reel-caption').value
                });
            })
            .then(function () {
                say('Done.');
                window.location = '{{ path('app_reel_index') }}';
            })
            .catch(function (err) {
                button.disabled = false;
                say(err.message);
            });
    });
})();
</script>
{% endblock %}
