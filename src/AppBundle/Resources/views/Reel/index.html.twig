{% extends "AppBundle::layout.html.twig" %}
{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header card-header-icon" data-background-color="rose">
                    <i class="material-icons">movie</i>
                </div>
                <div class="card-content">
                    <h4 class="card-title">Reels
                        <a href="{{ path('app_reel_add') }}" class="btn btn-fill btn-rose pull-right">
                            <i class="material-icons">add</i> Add reel
                        </a>
                    </h4>
                    {% if reels|length == 0 %}
                        <p class="text-muted">No reels yet. Use <b>Add reel</b>, or wait for one to come in from the app.</p>
                    {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead><tr>
                                <th></th><th>Author</th><th>Caption</th><th>Type</th>
                                <th>Likes</th><th>Views</th><th>Added</th><th>Shown</th><th></th>
                            </tr></thead>
                            <tbody>
                            {% for reel in reels %}
                                <tr>
                                    <td>
                                        {# A reel uploaded before the panel took its own
                                           still has the video itself as its thumbnail, and
                                           an <img> pointed at an MP4 is a broken picture.
                                           Anything that is not an image is shown as video,
                                           which draws its own first frame. #}
                                        {% set thumb = spaces.publicUrl(reel.thumb) %}
                                        {% set isPicture = thumb matches '/\\.(jpe?g|png|webp|gif)$/i' %}
                                        <a href="{{ spaces.publicUrl(reel.objectkey) }}" target="_blank">
                                            {% if thumb and isPicture %}
                                                <img src="{{ thumb }}"
                                                     style="width:54px;height:96px;object-fit:cover;border-radius:6px;background:#eee;" />
                                            {% elseif reel.type == 'video' %}
                                                {# No still, or one pointing at something that is not a picture:
                                                   show the reel itself, which draws its own first frame. #}
                                                <video src="{{ spaces.publicUrl(reel.objectkey) }}#t=0.5" muted preload="metadata"
                                                       style="width:54px;height:96px;object-fit:cover;border-radius:6px;background:#111;"></video>
                                            {% elseif thumb %}
                                                <img src="{{ thumb }}"
                                                     style="width:54px;height:96px;object-fit:cover;border-radius:6px;background:#eee;" />
                                            {% else %}
                                                <span class="text-muted"
                                                      style="display:inline-flex;width:54px;height:96px;align-items:center;justify-content:center;border-radius:6px;background:#eee;">
                                                    <i class="material-icons">movie</i>
                                                </span>
                                            {% endif %}
                                        </a>
                                    </td>
                                    <td>{{ reel.user ? reel.user.name : '-' }}</td>
                                    <td>{{ reel.caption|default('-')|slice(0, 60) }}</td>
                                    <td>{{ reel.type }}</td>
                                    <td>{{ reel.likes }}</td>
                                    <td>{{ reel.views }}</td>
                                    <td>{{ reel.created|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% if reel.enabled %}
                                            <span class="label label-success">Shown</span>
                                        {% else %}
                                            <span class="label label-default">Hidden</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-right">
                                        <a href="{{ path('app_reel_toggle', {'id': reel.id}) }}"
                                           class="btn btn-simple btn-warning btn-icon"
                                           title="{{ reel.enabled ? 'Hide from the app' : 'Show in the app' }}">
                                            <i class="material-icons">{{ reel.enabled ? 'visibility_off' : 'visibility' }}</i>
                                        </a>
                                        <a href="{{ path('app_reel_delete', {'id': reel.id}) }}"
                                           class="btn btn-simple btn-danger btn-icon"
                                           onclick="return confirm('Delete this reel? The row goes now; the file stays in your Space.');">
                                            <i class="material-icons">close</i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
