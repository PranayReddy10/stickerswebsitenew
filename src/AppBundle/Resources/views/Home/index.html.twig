{% extends "AppBundle::layout.html.twig" %}
{% block body %}

{# The dashboard used to be seventeen identical cards of lifetime totals, which
   never answered "how is it going this week". Today comes first, then the shape
   of the last fortnight, then the library, then what people are watching. #}
<div class="container-fluid">

    <div class="row">
        {% set change = activity.yesterday > 0
            ? ((activity.today - activity.yesterday) / activity.yesterday * 100)|round : null %}
        <div class="col-lg-3 col-md-6">
            <div class="tile accent-green">
                <p class="tile-label">Active today</p>
                <div class="tile-value">{{ activity.today }}</div>
                <div class="tile-note">
                    {% if change is null %}
                        no one yesterday to compare with
                    {% elseif change >= 0 %}
                        <span class="up">▲ {{ change }}%</span> against yesterday ({{ activity.yesterday }})
                    {% else %}
                        <span class="down">▼ {{ change|abs }}%</span> against yesterday ({{ activity.yesterday }})
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="tile accent-blue">
                <p class="tile-label">Active this week</p>
                <div class="tile-value">{{ activity.week }}</div>
                <div class="tile-note">{{ activity.month }} in the last 30 days</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="tile accent-orange">
                <p class="tile-label">New installs today</p>
                <div class="tile-value">{{ activity.new_today }}</div>
                <div class="tile-note">{{ activity.new_week }} in the last 7 days · {{ devices }} ever</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="tile accent-rose">
                <p class="tile-label">Subscribed now</p>
                <div class="tile-value">{{ subscriptions }}</div>
                <div class="tile-note"><a href="{{ path('app_subscription_index') }}">see who is paying</a></div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">People opening the app, last 14 days</h4>
                    <div class="spark green">
                        {% for day, count in activePerDay %}
                            <div class="col" title="{{ day }}: {{ count }}">
                                <span class="n">{{ count > 0 ? count : '' }}</span>
                                <div class="bar{{ count > 0 ? '' : ' flat' }}"
                                     style="height:{{ count > 0 ? (count / activePeak * 100)|round : 2 }}%;"></div>
                                <span class="d">{{ day|date('d/m') }}</span>
                            </div>
                        {% endfor %}
                    </div>
                    <p class="text-muted" style="font-size:12px;">
                        Devices that opened the app, counted once a day each.
                        {% if activity.undated > 0 %}
                            {{ activity.undated }} installed before this began being recorded
                            {{ activity.undated == 1 ? 'is' : 'are' }} not counted until
                            {{ activity.undated == 1 ? 'it comes' : 'they come' }} back.
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Reels posted, last 14 days</h4>
                    <div class="spark">
                        {% for day, count in reelsPerDay %}
                            <div class="col" title="{{ day }}: {{ count }}">
                                <span class="n">{{ count > 0 ? count : '' }}</span>
                                <div class="bar{{ count > 0 ? '' : ' flat' }}"
                                     style="height:{{ count > 0 ? (count / reelsPeak * 100)|round : 2 }}%;"></div>
                                <span class="d">{{ day|date('d/m') }}</span>
                            </div>
                        {% endfor %}
                    </div>
                    <p class="text-muted" style="font-size:12px;">
                        {{ reels }} live · {{ reelViews }} views · {{ reelLikes }} likes
                        {% if reelsPending > 0 %}
                            · <a href="{{ path('app_reel_reviews') }}">{{ reelsPending }} waiting for review</a>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# The library, and what needs a decision. One row of plain numbers rather
       than a card each: none of them changes hour to hour. #}
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">The library</h4>
                    {% set library = [
                        {'label': 'Sticker packs', 'value': packs,      'path': path('app_pack_index'),     'note': downloads ~ ' downloads'},
                        {'label': 'Stickers',      'value': stickers,   'path': path('app_pack_index'),     'note': 'across every pack'},
                        {'label': 'Reels',         'value': reels,      'path': path('app_reel_index'),     'note': reelViews ~ ' views'},
                        {'label': 'Categories',    'value': categories, 'path': path('app_category_index'), 'note': tags ~ ' tags'},
                        {'label': 'Users',         'value': users,      'path': path('user_user_index'),    'note': searchs ~ ' searches made'},
                        {'label': 'Slides',        'value': slides,     'path': path('app_slide_index'),    'note': 'on the home screen'}
                    ] %}
                    <div style="display:flex;flex-wrap:wrap;">
                        {% for item in library %}
                            <div style="width:33.33%;padding:14px 16px 14px 0;">
                                <div style="font-size:11px;font-weight:600;letter-spacing:.04em;
                                            text-transform:uppercase;color:#414855;">{{ item.label }}</div>
                                <div style="font-size:26px;color:#1d2129;line-height:1.2;">
                                    <a href="{{ item.path }}" style="color:#1d2129;">{{ item.value }}</a>
                                </div>
                                <div style="font-size:12px;color:#5b6472;">{{ item.note }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Needs you</h4>
                    <table class="table">
                        <tbody>
                            <tr>
                                <td><a href="{{ path('app_pack_reviews') }}">Packs to review</a></td>
                                <td class="text-right">
                                    <span class="pill {{ reviews > 0 ? 'pill-orange' : 'pill-hollow' }}">{{ reviews }}</span>
                                </td>
                            </tr>
                            <tr>
                                <td><a href="{{ path('app_reel_reviews') }}">Reels to review</a></td>
                                <td class="text-right">
                                    <span class="pill {{ reelsPending > 0 ? 'pill-orange' : 'pill-hollow' }}">{{ reelsPending }}</span>
                                </td>
                            </tr>
                            <tr>
                                <td><a href="{{ path('app_support_index') }}">Messages</a></td>
                                <td class="text-right">
                                    <span class="pill {{ supports > 0 ? 'pill-rose' : 'pill-hollow' }}">{{ supports }}</span>
                                </td>
                            </tr>
                            <tr>
                                <td><a href="{{ path('app_version_index') }}">App versions</a></td>
                                <td class="text-right"><span class="pill pill-hollow">{{ versions }}</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">
                        Most watched reels
                        <a href="{{ path('app_reel_index') }}" class="btn btn-simple btn-rose btn-sm pull-right">All reels</a>
                    </h4>
                    {% if topReels|length == 0 %}
                        <p class="text-muted">Nothing has been watched yet.</p>
                    {% else %}
                        <table class="table">
                            <tbody>
                            {% for reel in topReels %}
                                <tr>
                                    <td style="width:44px;">
                                        {% set thumb = spaces.publicUrl(reel.thumb) %}
                                        {% if thumb and thumb matches '/\\.(jpe?g|png|webp|gif)$/i' %}
                                            <img src="{{ thumb }}" style="width:32px;height:56px;object-fit:cover;border-radius:4px;background:#eee;" />
                                        {% elseif reel.type == 'video' %}
                                            <video src="{{ spaces.publicUrl(reel.objectkey) }}#t=0.5" muted preload="metadata"
                                                   style="width:32px;height:56px;object-fit:cover;border-radius:4px;background:#111;"></video>
                                        {% else %}
                                            <span style="display:inline-flex;width:32px;height:56px;align-items:center;justify-content:center;border-radius:4px;background:#eee;color:#8b94a3;">
                                                <i class="material-icons" style="font-size:18px;">movie</i>
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if reel.user %}
                                            <a href="{{ path('user_user_view', {'id': reel.user.id}) }}"><b>{{ reel.user.name }}</b></a>
                                        {% else %}
                                            <b>Panel</b>
                                        {% endif %}
                                        <br>
                                        <span class="text-muted" style="font-size:12px;">
                                            {{ reel.caption|default('')|slice(0, 40) ?: 'No caption' }}
                                        </span>
                                    </td>
                                    <td class="text-right" style="white-space:nowrap;">
                                        {{ reel.views }} <i class="material-icons" style="font-size:14px;">visibility</i>
                                        &nbsp;{{ reel.likes }} <i class="material-icons" style="font-size:14px;">favorite</i>
                                    </td>
                                    <td class="text-right" style="width:90px;">
                                        <a href="{{ path('app_reel_share', {'id': reel.id}) }}" target="_blank"
                                           class="btn btn-simple btn-default btn-sm">Open</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
