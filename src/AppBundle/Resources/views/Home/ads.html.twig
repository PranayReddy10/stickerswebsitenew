{% extends "AppBundle::layout.html.twig" %}
{% block body%}
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <div class="card">
                    <div class="tab-moivie">
                        <a href="{{path("app_home_settings")}}" class="btn btn-tab-movie col-md-12"><i class="material-icons">settings</i> Settings</a>
                        <a href="{{path("app_home_ads")}}" class="btn btn-tab-movie-active col-md-12"><i class="material-icons">monetization_on</i> Ads Settings</a>
                        <a href="{{path("fos_user_change_password")}}" class="btn btn-tab-movie col-md-12"><i class="material-icons">lock</i> Change password</a>
                    </div>
                </div>
            </div>

            <div class="col-md-9">
                <div class="card">
                    <div class="card-header card-header-icon" data-background-color="rose">
                        <i class="material-icons">monetization_on</i>
                    </div>
                    <div class="card-content">
                        <h4 class="card-title">Ads Settings</h4>
                        {{form_start(form)}}
                        <div class="panel-body">
                            <label class="panel-title">AdMob account</label>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AdMob Publisher id</label>
                                {{form_widget(form.publisherid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.publisherid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AdMob App id</label>
                                {{form_widget(form.appid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.appid)}}</span>
                        </div>

                        <div class="panel-body">
                            <label class="panel-title">Global ad behaviour</label>
                            <p class="text-muted" style="margin:0 0 10px 0;">These control how the app moves from one network to the next when a network has no ad to give.</p>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Unity Ads Game id</label>
                                {{form_widget(form.unitygameid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.unitygameid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Liftoff Monetize (Vungle) App id</label>
                                {{form_widget(form.vungleappid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.vungleappid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">InMobi Account id</label>
                                {{form_widget(form.inmobiaccountid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.inmobiaccountid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Seconds to wait for a network before trying the next one</label>
                                {{form_widget(form.adtimeout,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.adtimeout)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Automatic fallback</label>
                                {{form_widget(form.adfallback,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.adfallback)}}</span>
                        </div>

                        <div class="panel-body">
                            <label class="panel-title">Banner ads</label>
                            <p class="text-muted" style="margin:0 0 10px 0;">Leave the order empty to use the type above followed by every other network that has an id. To pin an order, write the networks separated by commas, for example <code>ADMOB,MAX,FACEBOOK,UNITY,VUNGLE,INMOBI</code>. A network with an empty id is skipped automatically.</p>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Banner Ad Type</label>
                                {{form_widget(form.bannertype,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannertype)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AdMob unit id</label>
                                {{form_widget(form.banneradmobid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.banneradmobid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin MAX unit id</label>
                                {{form_widget(form.bannermaxid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannermaxid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin zone id</label>
                                {{form_widget(form.bannerapplovinid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannerapplovinid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Meta placement id</label>
                                {{form_widget(form.bannerfacebookid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannerfacebookid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Unity placement id</label>
                                {{form_widget(form.bannerunityid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannerunityid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Vungle placement id</label>
                                {{form_widget(form.bannervungleid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannervungleid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">InMobi placement id</label>
                                {{form_widget(form.bannerinmobiid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannerinmobiid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Waterfall order</label>
                                {{form_widget(form.bannerorder,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.bannerorder)}}</span>
                        </div>

                        <div class="panel-body">
                            <label class="panel-title">Native ads (inside the pack lists and on the pack page)</label>
                            <p class="text-muted" style="margin:0 0 10px 0;">Native ads are served by AdMob, AppLovin MAX and Meta only. Vungle, Unity and InMobi have no native format here, so they are skipped for this placement.</p>
                            <p class="text-muted" style="margin:0 0 10px 0;">Set <b>Packs between two native ads</b> to 3 or 4 to show an ad every few packs on the home screen.</p>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Native Ad Type</label>
                                {{form_widget(form.nativetype,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativetype)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AdMob unit id</label>
                                {{form_widget(form.nativeadmobid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativeadmobid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin MAX unit id</label>
                                {{form_widget(form.nativemaxid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativemaxid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Meta placement id</label>
                                {{form_widget(form.nativefacebookid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativefacebookid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Meta native banner placement id</label>
                                {{form_widget(form.nativebannerfacebookid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativebannerfacebookid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Waterfall order</label>
                                {{form_widget(form.nativeorder,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativeorder)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Packs between two native ads</label>
                                {{form_widget(form.nativeitem,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.nativeitem)}}</span>
                        </div>

                        <div class="panel-body">
                            <label class="panel-title">Interstitial (full screen) ads</label>
                            <p class="text-muted" style="margin:0 0 10px 0;">Leave the order empty to use the type above followed by every other network that has an id. To pin an order, write the networks separated by commas, for example <code>ADMOB,MAX,FACEBOOK,UNITY,VUNGLE,INMOBI</code>. A network with an empty id is skipped automatically.</p>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Interstitial Ad Type</label>
                                {{form_widget(form.interstitialtype,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialtype)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AdMob unit id</label>
                                {{form_widget(form.interstitialadmobid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialadmobid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin MAX unit id</label>
                                {{form_widget(form.interstitialmaxid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialmaxid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin zone id</label>
                                {{form_widget(form.interstitialapplovinid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialapplovinid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Meta placement id</label>
                                {{form_widget(form.interstitialfacebookid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialfacebookid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Unity placement id</label>
                                {{form_widget(form.interstitialunityid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialunityid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Vungle placement id</label>
                                {{form_widget(form.interstitialvungleid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialvungleid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">InMobi placement id</label>
                                {{form_widget(form.interstitialinmobiid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialinmobiid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Waterfall order</label>
                                {{form_widget(form.interstitialorder,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialorder)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Clicks between two interstitials</label>
                                {{form_widget(form.interstitialclick,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.interstitialclick)}}</span>
                        </div>

                        <div class="panel-body">
                            <label class="panel-title">Rewarded ads</label>
                            <p class="text-muted" style="margin:0 0 10px 0;">Used to unlock premium packs, and for the download placement below when it is set to Rewarded.</p>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Rewarded Ad Type</label>
                                {{form_widget(form.rewardedtype,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedtype)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AdMob unit id</label>
                                {{form_widget(form.rewardedadmobid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedadmobid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin MAX unit id</label>
                                {{form_widget(form.rewardedmaxid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedmaxid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">AppLovin zone id</label>
                                {{form_widget(form.rewardedapplovinid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedapplovinid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Meta placement id</label>
                                {{form_widget(form.rewardedfacebookid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedfacebookid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Unity placement id</label>
                                {{form_widget(form.rewardedunityid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedunityid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Vungle placement id</label>
                                {{form_widget(form.rewardedvungleid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedvungleid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">InMobi placement id</label>
                                {{form_widget(form.rewardedinmobiid,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedinmobiid)}}</span>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Waterfall order</label>
                                {{form_widget(form.rewardedorder,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.rewardedorder)}}</span>
                        </div>

                        <div class="panel-body">
                            <label class="panel-title">Add to WhatsApp / Telegram / Signal</label>
                            <p class="text-muted" style="margin:0 0 10px 0;">Ad shown when the user adds a <b>free</b> pack. Premium packs keep using the rewarded unlock dialog. This placement reuses the settings above: pick <b>Full screen</b> and it uses the Interstitial section (including the click counter), pick <b>Rewarded</b> and it uses the Rewarded section. If that section is disabled the pack is simply added with no ad.</p>
                            <div class="form-group label-floating is-empty">
                                <label class="control-label">Ad on download</label>
                                {{form_widget(form.downloadadtype,{"attr":{"class":"form-control"}})}}
                            </div>
                            <span class="validate-input">{{form_errors(form.downloadadtype)}}</span>
                        </div>
                        <span class="pull-right"><a href="{{path("app_category_index")}}" class="btn btn-fill btn-yellow"><i class="material-icons">arrow_back</i> Cancel</a>{{form_widget(form.save,{attr:{"class":"btn btn-fill btn-rose"}})}}</span>

                    </div>
                    {{form_end(form)}}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock%}
