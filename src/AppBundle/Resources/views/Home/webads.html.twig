{% extends "AppBundle::layout.html.twig" %}
{% block body %}

{# Ads on the public website. Two ways to fill a slot: paste the network's own
   code, or upload a banner of your own. Code wins where there is any. #}
<div class="container-fluid">

    <div class="row">
        <div class="col-md-12">
            <h4 style="margin:0 0 4px 0;color:#1d2129;">Website ads</h4>
            <p class="text-muted" style="margin-bottom:14px;">
                On the sticker pack and reel pages. These are the website's own ads -
                the app's are on the Ads page and have nothing to do with these.
            </p>
            <div class="filters">
                <a href="{{ path('app_home_settings') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">settings</i> App
                </a>
                <a href="{{ path('app_home_ads') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">monetization_on</i> Ads
                </a>
                <a href="{{ path('app_home_site') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">public</i> Website
                </a>
                <a href="{{ path('app_home_webads') }}" class="on">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">ad_units</i> Website ads
                </a>
                <a href="{{ path('app_home_shop') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">shopping_bag</i> Shop
                </a>
                <a href="{{ path('app_home_policies') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">gavel</i> Policies
                </a>
            </div>
        </div>
    </div>

    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-7">

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">On or off</h4>
                    <div class="form-group">
                        <label class="control-label">Ads on the website</label>
                        {{ form_widget(form.webadsenabled, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadsenabled) }}</span>
                    </div>
                    <p class="text-muted" style="margin:6px 0 0 0;font-size:12.5px;">
                        Off means nothing is rendered anywhere, whatever is saved below -
                        so you can set all of this up before switching it on.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Your ad network</h4>
                    <p class="text-muted" style="margin:-6px 0 14px 0;font-size:12.5px;">
                        Paste what the network gave you. It goes into the page exactly as
                        typed, which is the only way such a tag can work - so put nothing
                        here but the network's own code.
                    </p>

                    <div class="form-group">
                        <label class="control-label">Code for the page head</label>
                        {{ form_widget(form.webadshead, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadshead) }}</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Above the grid</label>
                        {{ form_widget(form.webadstop, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadstop) }}</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Inside the grid</label>
                        {{ form_widget(form.webadsfeed, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadsfeed) }}</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Below the grid</label>
                        {{ form_widget(form.webadsbottom, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadsbottom) }}</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Packs or reels between in-grid ads</label>
                        {{ form_widget(form.webadsevery, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadsevery) }}</span>
                    </div>
                    <p class="text-muted" style="margin:0;font-size:12.5px;">
                        Blank or under 3 means every 8. Reels keep loading as you scroll,
                        so an in-grid ad reappears at that interval all the way down.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-5">

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Your own banner</h4>
                    <p class="text-muted" style="margin:-6px 0 14px 0;font-size:12.5px;">
                        Used in any slot above you left empty. Another of your apps, the
                        shop, anything - so the site can carry ads with no network at all.
                    </p>

                    <label class="control-label" style="display:block;margin-bottom:4px;">
                        Wide banner &mdash; pages and grids
                    </label>
                    <p class="text-muted" style="margin:0 0 8px 0;font-size:12.5px;">
                        <b>970 &times; 250</b> is the size to aim for. 728 &times; 90 and
                        1200 &times; 300 work too. Shown up to 970px across and scaled down
                        from there, so anything narrower than 728 looks soft on a desktop.
                        {% if bannersize %}
                            <br><span style="color:#2fa77a;">Yours is {{ bannersize }}.</span>
                        {% endif %}
                    </p>

                    {% if setting.webadsbanner %}
                        <p style="margin-bottom:10px;">
                            <img src="{{ setting.webadsbanner.remote
                                ? setting.webadsbanner.url
                                : asset(setting.webadsbanner.link) }}"
                                 alt="" style="max-width:100%;border-radius:10px;">
                        </p>
                    {% endif %}

                    <div class="form-group">
                        {{ form_widget(form.webadsbannerfile) }}
                        <span class="validate-input">{{ form_errors(form.webadsbannerfile) }}</span>
                    </div>

                    <hr style="margin:18px 0;">

                    <label class="control-label" style="display:block;margin-bottom:4px;">
                        Tall banner &mdash; between reels
                    </label>
                    <p class="text-muted" style="margin:0 0 8px 0;font-size:12.5px;">
                        <b>1080 &times; 1350</b> is the size to aim for; 1080 &times; 1920
                        also fits. A reel fills a portrait screen, where the wide banner
                        would be a sliver &mdash; but leave this empty and the wide one is
                        used anyway, just smaller. Shown up to 440px across and never
                        taller than about three quarters of the screen.
                        {% if reelbannersize %}
                            <br><span style="color:#2fa77a;">Yours is {{ reelbannersize }}.</span>
                        {% endif %}
                    </p>

                    {% if setting.webadsreelbanner %}
                        <p style="margin-bottom:10px;">
                            <img src="{{ setting.webadsreelbanner.remote
                                ? setting.webadsreelbanner.url
                                : asset(setting.webadsreelbanner.link) }}"
                                 alt="" style="max-width:160px;border-radius:10px;">
                        </p>
                    {% endif %}

                    <div class="form-group">
                        {{ form_widget(form.webadsreelbannerfile) }}
                        <span class="validate-input">{{ form_errors(form.webadsreelbannerfile) }}</span>
                    </div>

                    <hr style="margin:18px 0;">

                    <div class="form-group">
                        <label class="control-label">Where the banner goes</label>
                        {{ form_widget(form.webadsbannerurl, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadsbannerurl) }}</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Line under the banner</label>
                        {{ form_widget(form.webadsbannertext, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.webadsbannertext) }}</span>
                    </div>
                    <p class="text-muted" style="margin:0;font-size:12.5px;">
                        One address for both banners - it is the same advertiser. A banner
                        with no address is not shown: there would be nowhere to go.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Sizes for network code</h4>
                    <p class="text-muted" style="margin:-6px 0 10px 0;font-size:12.5px;">
                        If you are pasting a network's code rather than using a banner, a
                        <b>responsive</b> unit is the one to ask for: it measures the slot
                        and fills it. These are the sizes that suit each slot if you have
                        to pick fixed ones.
                    </p>
                    <p class="text-muted" style="margin:0;font-size:12.5px;">
                        <b>Above and below the grid</b><br>
                        728 &times; 90, 970 &times; 250 on a desktop; 320 &times; 100 on a phone<br><br>
                        <b>Inside the grid</b><br>
                        336 &times; 280 or 300 &times; 250 &mdash; it has a full row to itself<br><br>
                        <b>Between reels</b><br>
                        300 &times; 250, or a portrait 320 &times; 480
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Where they appear</h4>
                    <p class="text-muted" style="margin:0 0 10px 0;font-size:12.5px;">
                        <b>/stickers.html</b><br>above, inside and below the grid<br><br>
                        <b>/stickers/&lt;id&gt;.html</b><br>above and below a pack<br><br>
                        <b>/reels.html</b><br>above, inside and below the grid, and the in-grid
                        ones keep coming as more reels load<br><br>
                        <b>/reels/&lt;id&gt;.html</b><br>a screen of its own between reels, at
                        the same interval, as you scroll the feed
                    </p>
                    <p class="text-muted" style="margin:0;font-size:12.5px;">
                        Every slot is labelled "Advertisement" and sits on its own row, so
                        nothing can be mistaken for one of your packs. Each one is sized by
                        the space it has rather than by a fixed number, so the same code
                        works on a phone and on a desktop; a responsive unit from your
                        network will fit itself, and a fixed one is held to the column
                        width instead of pushing the page sideways. A slot your network
                        does not fill is hidden, label and all.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12" style="margin-bottom:30px;">
            {{ form_widget(form.save, {"attr": {"class": "btn btn-primary"}}) }}
        </div>
    </div>
    {{ form_end(form) }}
</div>

{% endblock %}
