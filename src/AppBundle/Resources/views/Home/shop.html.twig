{% extends "AppBundle::layout.html.twig" %}
{% block body %}

{# The shop is somebody else's website. All this holds is where it is, whether to
   point at it, and the key to read its products with. #}
<div class="container-fluid">

    <div class="row">
        <div class="col-md-12">
            <h4 style="margin:0 0 4px 0;color:#1d2129;">Shop</h4>
            <p class="text-muted" style="margin-bottom:14px;">
                Put your store in the app: a button in the menu, and its products
                available to the app through this server.
            </p>
            <div class="filters">
                <a href="{{ path('app_home_settings') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">settings</i> App
                </a>
                <a href="{{ path('app_home_ads') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">monetization_on</i> Ads
                </a>
                <a href="{{ path('app_home_site') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">public</i> Website
                </a>
                <a href="{{ path('app_housead_index') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">photo_size_select_large</i> Your own ads
                </a>
                <a href="{{ path('app_home_webads') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">web_asset</i> Website ads
                </a>
                <a href="{{ path('app_home_shop') }}" class="on">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">local_mall</i> Shop
                </a>
                <a href="{{ path('app_home_policies') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">gavel</i> Policies
                </a>
            </div>
        </div>
    </div>

    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-7">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">On or off</h4>
                    <div class="form-group">
                        <label class="control-label">The shop</label>
                        {{ form_widget(form.shopenabled, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.shopenabled) }}</span>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Shop button in the app</label>
                        {{ form_widget(form.shopbutton, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.shopbutton) }}</span>
                    </div>
                    <p class="text-muted" style="font-size:12.5px;">
                        Both are read when the app starts, so a change reaches phones on
                        their next launch rather than their next update.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Where it is</h4>

                    <div class="form-group label-floating">
                        <label class="control-label">What the button says</label>
                        {{ form_widget(form.shopname, {"attr": {"class": "form-control",
                            "placeholder": "Shop"}}) }}
                        <span class="validate-input">{{ form_errors(form.shopname) }}</span>
                    </div>

                    <div class="form-group label-floating">
                        <label class="control-label">Shop website</label>
                        {{ form_widget(form.shopurl, {"attr": {"class": "form-control",
                            "placeholder": "https://example.co.in"}}) }}
                        <span class="validate-input">{{ form_errors(form.shopurl) }}</span>
                        <p class="text-muted" style="font-size:12px;margin-top:4px;">
                            Where the button goes.
                        </p>
                    </div>

                    <div class="form-group label-floating">
                        <label class="control-label">Products endpoint</label>
                        {{ form_widget(form.shopapiurl, {"attr": {"class": "form-control",
                            "placeholder": setting.shopurl ? setting.shopEndpoint : "https://example.co.in/api/v1/products"}}) }}
                        <span class="validate-input">{{ form_errors(form.shopapiurl) }}</span>
                        <p class="text-muted" style="font-size:12px;margin-top:4px;">
                            Leave empty and it is worked out from the website as
                            <code>/api/v1/products</code>.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">API key</h4>

                    <div class="form-group label-floating">
                        <label class="control-label">
                            {{ setting.hasShopKey ? 'Replace the key' : 'API key' }}
                        </label>
                        {{ form_widget(form.shopapikey, {"attr": {"class": "form-control",
                            "autocomplete": "new-password"}}) }}
                        <span class="validate-input">{{ form_errors(form.shopapikey) }}</span>
                    </div>

                    <p class="text-muted" style="font-size:12.5px;">
                        {% if setting.hasShopKey %}
                            A key is stored. It is never shown again - leave this empty to keep
                            it, or paste a new one to replace it.
                        {% else %}
                            No key stored yet. Leave it empty if your shop's products are open
                            to anyone.
                        {% endif %}
                    </p>
                    <p class="text-muted" style="font-size:12.5px;">
                        <b>The key stays on this server.</b> The app asks this server for
                        products and this server asks the shop, so the key is never inside an
                        APK where anybody with the file could read it out - and you can change
                        it here without shipping an update.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Does it work?</h4>
                    <button type="button" id="shop-check" class="btn btn-simple btn-rose">
                        <i class="material-icons">sync</i> Ask the shop now
                    </button>
                    <p id="shop-check-result" class="text-muted" style="margin-top:10px;"></p>
                    <p class="text-muted" style="font-size:12px;">
                        Save first - this asks with what is stored, not with what is typed.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">What the app gets</h4>
                    <table class="table">
                        <tbody>
                            <tr><td>Products</td>
                                <td class="text-right"><code>/api/shop/products/…</code></td></tr>
                            <tr><td>Cached for</td><td class="text-right">5 minutes</td></tr>
                        </tbody>
                    </table>
                    <p class="text-muted" style="font-size:12px;">
                        The shop's own JSON, passed through untouched - name, prices, images,
                        variants and categories, exactly as your shop sends them.
                    </p>
                </div>
            </div>

            <div class="card">
                <div class="card-content" style="display:flex;align-items:center;">
                    {{ form_widget(form.save, {attr: {"class": "btn btn-fill btn-rose"}}) }}
                    <a href="{{ path('app_home_index') }}" class="btn btn-simple btn-default"
                       style="margin-left:8px;">Cancel</a>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}

</div>

<script>
/* Asks the shop through this server and prints whatever came back, good or bad. */
(function () {
    var button = document.getElementById('shop-check');
    if (!button) { return; }
    var out = document.getElementById('shop-check-result');

    button.addEventListener('click', function () {
        button.disabled = true;
        out.textContent = 'Asking the shop...';
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '{{ path('app_shop_admin_check') }}');
        xhr.onload = function () {
            button.disabled = false;
            var parsed;
            try { parsed = JSON.parse(xhr.responseText); }
            catch (e) { out.textContent = 'The server answered HTTP ' + xhr.status; return; }
            out.textContent = parsed.message || ('error ' + parsed.code);
            out.style.color = parsed.code === 200 ? '#2e7d32' : '#c62828';
        };
        xhr.onerror = function () {
            button.disabled = false;
            out.textContent = 'Could not reach this server.';
        };
        xhr.send();
    });
})();
</script>
{% endblock %}
