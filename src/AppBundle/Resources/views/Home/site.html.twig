{% extends "AppBundle::layout.html.twig" %}
{% block body %}

{# What a stranger sees: the name in the tab, the sentence under it in a search
   result, and the picture a chat app shows when the link is pasted. #}
<div class="container-fluid">

    <div class="row">
        <div class="col-md-12">
            <h4 style="margin:0 0 4px 0;color:#1d2129;">Website</h4>
            <p class="text-muted" style="margin-bottom:14px;">
                The packs and reels have pages anyone can open, share and find in a search.
                This is what those pages say they are.
            </p>
            <div class="filters">
                <a href="{{ path('app_home_settings') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">settings</i> App
                </a>
                <a href="{{ path('app_home_ads') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">monetization_on</i> Ads
                </a>
                <a href="{{ path('app_home_site') }}" class="on">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">public</i> Website
                </a>
                <a href="{{ path('app_housead_index') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">photo_size_select_large</i> Your own ads
                </a>
                <a href="{{ path('app_home_webads') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">web_asset</i> Website ads
                </a>
                <a href="{{ path('app_home_shop') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">local_mall</i> Shop
                </a>
                <a href="{{ path('app_home_policies') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">gavel</i> Policies
                </a>
                <a href="{{ path('fos_user_change_password') }}">
                    <i class="material-icons" style="font-size:15px;vertical-align:-3px;">lock</i> Change password
                </a>
            </div>
        </div>
    </div>

    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-7">
            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">What it is called</h4>
                    <p class="text-muted" style="font-size:12.5px;">
                        Leave either empty and the site borrows the app's own name and
                        description, so nothing here is required.
                    </p>

                    <div class="form-group label-floating">
                        <label class="control-label">Site name</label>
                        {{ form_widget(form.sitename, {"attr": {"class": "form-control",
                            "placeholder": setting.appname}}) }}
                        <span class="validate-input">{{ form_errors(form.sitename) }}</span>
                    </div>

                    <div class="form-group label-floating">
                        <label class="control-label">Description</label>
                        {{ form_widget(form.sitedescription, {"attr": {"class": "form-control",
                            "placeholder": setting.appdescription}}) }}
                        <span class="validate-input">{{ form_errors(form.sitedescription) }}</span>
                        <p class="text-muted" style="font-size:12px;margin-top:4px;">
                            One sentence, around 150 characters. It is the line under the title
                            in a search result.
                        </p>
                    </div>

                    <div class="form-group label-floating">
                        <label class="control-label">Keywords</label>
                        {{ form_widget(form.sitekeywords, {"attr": {"class": "form-control",
                            "placeholder": "whatsapp stickers, sticker packs, reels"}}) }}
                        <span class="validate-input">{{ form_errors(form.sitekeywords) }}</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">The site itself</h4>
                    <div class="form-group">
                        {{ form_widget(form.siteenabled, {"attr": {"class": "form-control"}}) }}
                        <span class="validate-input">{{ form_errors(form.siteenabled) }}</span>
                    </div>
                    <p class="text-muted" style="font-size:12.5px;">
                        Switching it off makes every public page answer 404 and empties the
                        sitemap. The panel and the app carry on either way.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <style>
                /* The theme all but hides a file input, so the picture pickers
                   here are a hidden input and a label, the same as the ads page. */
                .pic { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
                .pic .shot { width:92px; height:92px; border-radius:14px; flex:none;
                             border:1px solid #e4e7ec; background:#f7f8fa center/contain no-repeat; }
                .pic .shot.small { width:56px; height:56px; border-radius:12px; }
                .pic .shot.none { display:flex; align-items:center; justify-content:center;
                                  color:#b9bfc9; font-size:10.5px; text-align:center; padding:6px; }
                .pic .take { flex:1; min-width:190px; }
                .pic input[type=file] { position:absolute; width:1px; height:1px; opacity:0;
                                        overflow:hidden; clip:rect(0 0 0 0); }
                .pic label.btn-file { display:inline-flex; align-items:center; gap:8px; margin:0;
                    cursor:pointer; border:1px solid #e4e7ec; border-radius:9px; background:#fff;
                    padding:9px 14px; font-size:13px; font-weight:600; color:#1d2129; }
                .pic label.btn-file:hover { border-color:#e91e63; color:#e91e63; background:#fff6f9; }
                .pic input[type=file]:focus + label.btn-file { border-color:#e91e63;
                    box-shadow:0 0 0 3px rgba(233,30,99,.10); }
                .pic .chosen { display:block; margin-top:7px; font-size:12px; color:#5b6472;
                               word-break:break-all; }
                .sizetag { display:inline-block; border-radius:6px; padding:2px 7px;
                           font-size:11.5px; font-weight:600; background:#eef1f5; color:#44506a; }
                .sizetag.good { background:#e3f6ee; color:#146c48; }
            </style>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Header logo</h4>
                    <p class="text-muted" style="margin:-6px 0 14px 0;font-size:12.5px;">
                        Shown beside the site name at the top of every page, and used as the
                        picture when a link to the site is pasted into a chat.
                    </p>
                    <div class="pic">
                        {% if setting.logo %}
                            <span class="shot" style="background-image:url('{{ setting.logo.remote
                                ? setting.logo.url : asset(setting.logo.link) }}');"></span>
                        {% elseif setting.siteLogo %}
                            <span class="shot" style="background-image:url('{{ setting.siteLogo.remote
                                ? setting.siteLogo.url : asset(setting.siteLogo.link) }}');"></span>
                        {% else %}
                            <span class="shot none">No logo</span>
                        {% endif %}
                        <span class="take">
                            {{ form_widget(form.logofile, {"attr": {"class": "pic-file", "data-for": "logo"}}) }}
                            <label class="btn-file" for="{{ form.logofile.vars.id }}">
                                <i class="material-icons" style="font-size:17px;">file_upload</i>
                                {{ setting.logo ? 'Replace logo' : 'Choose a logo' }}
                            </label>
                            <span class="chosen" id="chosen-logo"></span>
                        </span>
                    </div>
                    <p class="text-muted" style="font-size:12px;margin-top:12px;">
                        Square, around <span class="sizetag">512 × 512</span>.
                        {% if logosize %}Yours is <span class="sizetag good">{{ logosize }}</span>.{% endif %}
                        Empty uses the app image from Settings.
                    </p>
                    <span class="validate-input">{{ form_errors(form.logofile) }}</span>
                </div>
            </div>

            <div class="card">
                <div class="card-content">
                    <h4 class="card-title">Site icon</h4>
                    <p class="text-muted" style="margin:-6px 0 14px 0;font-size:12.5px;">
                        The little one on the browser tab, and what a phone keeps when
                        somebody saves the site to their home screen.
                    </p>
                    <div class="pic">
                        {% if setting.favicon %}
                            <span class="shot small" style="background-image:url('{{ setting.favicon.remote
                                ? setting.favicon.url : asset(setting.favicon.link) }}');"></span>
                        {% else %}
                            <span class="shot small none">Using the logo</span>
                        {% endif %}
                        <span class="take">
                            {{ form_widget(form.faviconfile, {"attr": {"class": "pic-file", "data-for": "icon"}}) }}
                            <label class="btn-file" for="{{ form.faviconfile.vars.id }}">
                                <i class="material-icons" style="font-size:17px;">file_upload</i>
                                {{ setting.favicon ? 'Replace icon' : 'Choose an icon' }}
                            </label>
                            <span class="chosen" id="chosen-icon"></span>
                        </span>
                    </div>
                    <p class="text-muted" style="font-size:12px;margin-top:12px;">
                        Square, <span class="sizetag">512 × 512</span> or
                        <span class="sizetag">192 × 192</span>. PNG with a transparent
                        background works best.
                        {% if iconsize %}Yours is <span class="sizetag good">{{ iconsize }}</span>.{% endif %}
                        Leave it empty and the logo is used; with neither, the icon that
                        came with the theme.
                    </p>
                    <p class="text-muted" style="font-size:12px;margin:0;">
                        It is read at about 16 pixels on a tab, so a picture with words on
                        it turns into a smudge. A single shape or letter reads best.
                    </p>
                    <span class="validate-input">{{ form_errors(form.faviconfile) }}</span>
                </div>
            </div>
            </div>

            <div class="card">
                <div class="card-content" style="display:flex;align-items:center;">
                    {{ form_widget(form.save, {attr: {"class": "btn btn-fill btn-rose"}}) }}
                    <a href="{{ path('app_home_index') }}" class="btn btn-simple btn-default"
                       style="margin-left:8px;">Cancel</a>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}

</div>

<script>
/* A hidden input says nothing on its own, and "did that upload take?" is the
   whole question at this point. */
(function () {
    Array.prototype.forEach.call(document.querySelectorAll('.pic-file'), function (input) {
        input.addEventListener('change', function () {
            var where = document.getElementById('chosen-' + input.getAttribute('data-for'));
            if (!where) { return; }
            if (!input.files || !input.files.length) { where.textContent = ''; return; }
            var file = input.files[0];
            where.textContent = file.name + ' - not saved yet';

            var box = input.parentNode.parentNode.querySelector('.shot');
            if (box && window.FileReader && /^image\//.test(file.type)) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    box.className = box.className.replace(' none', '');
                    box.textContent = '';
                    box.style.backgroundImage = "url('" + e.target.result + "')";
                    var probe = new Image();
                    probe.onload = function () {
                        where.textContent = file.name + ' - ' + probe.width + ' \u00d7 '
                            + probe.height + ', not saved yet';
                    };
                    probe.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    });
})();
</script>

{% endblock %}
