{# The public site's own shell. Nothing here extends the panel layout: this is
   what a stranger and a crawler see, and it must not load a megabyte of admin
   CSS to say what a sticker pack is. #}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    <title>{% block title %}{{ setting.siteTitle }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ setting.siteSummary }}{% endblock %}">
    {% if setting.sitekeywords %}<meta name="keywords" content="{{ setting.sitekeywords }}">{% endif %}
    <link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost }}{{ app.request.pathInfo }}{% endblock %}">

    {# What a chat app shows when the link is pasted. #}
    <meta property="og:site_name" content="{{ setting.siteTitle }}">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:url" content="{{ block('canonical') }}">
    <meta property="og:type" content="website">
    {% block og_image %}
        {% if setting.siteLogo %}
            {# A logo kept in the Space is already a whole URL; one on this server is not. #}
            <meta property="og:image" content="{{ setting.siteLogo.remote
                ? setting.siteLogo.url
                : app.request.schemeAndHttpHost ~ '/' ~ setting.siteLogo.link }}">
        {% endif %}
    {% endblock %}
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" type="image/png" href="{{ asset('img/favicon.png') }}">
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css?family=Rubik:300,400,500,600" rel="stylesheet">
    <style>
        :root { --ink:#15181f; --muted:#666f7d; --line:#e7e9ee; --rose:#e91e63; }
        * { box-sizing: border-box; }
        body { margin:0; background:#fff; color:var(--ink);
               font-family:Rubik,-apple-system,"Segoe UI",Roboto,sans-serif; font-size:15px; line-height:1.55; }
        a { color:#c2185b; text-decoration:none; }
        a:hover { text-decoration:underline; }
        img { max-width:100%; }
        .wrap { max-width:1080px; margin:0 auto; padding:0 18px; }

        header.top { border-bottom:1px solid var(--line); background:#fff; position:sticky; top:0; z-index:5; }
        header.top .wrap { display:flex; align-items:center; height:62px; }
        header.top .mark { display:flex; align-items:center; font-weight:600; color:var(--ink); }
        header.top .mark img { width:32px; height:32px; border-radius:9px; margin-right:10px; object-fit:cover; }
        header.top nav { margin-left:auto; }
        header.top nav a { color:#3b424e; font-size:14px; margin-left:20px; }
        header.top nav a.get { background:var(--rose); color:#fff; padding:8px 16px; border-radius:20px; }

        h1 { font-size:30px; font-weight:600; line-height:1.25; margin:0 0 10px 0; }
        h2 { font-size:20px; font-weight:600; margin:34px 0 14px 0; }
        .lede { color:var(--muted); font-size:16px; margin:0 0 18px 0; }

        .grid { display:flex; flex-wrap:wrap; margin:0 -8px; }
        .cell { padding:8px; width:16.66%; }
        @media (max-width:1000px){ .cell{ width:20%; } }
        @media (max-width:820px){ .cell{ width:25%; } }
        @media (max-width:620px){ .cell{ width:33.33%; } }
        @media (max-width:420px){ .cell{ width:50%; } }

        .tile { display:block; border:1px solid var(--line); border-radius:14px; overflow:hidden; background:#fff; }
        .tile:hover { border-color:#d4d8e0; text-decoration:none; }
        /* These are spans inside an <a>, so they are inline until told otherwise -
           and an inline box has no height for padding-top to build a square out
           of, which left every tray image collapsed to nothing. */
        .tile .art { display:block; background:#f4f5f8; padding-top:100%; position:relative; }
        .tile .art img { position:absolute; top:8%; left:8%; width:84%; height:84%; object-fit:contain; }
        .tile .name { display:block; padding:9px 10px 11px 10px; }
        .tile .name b { display:block; color:var(--ink); font-weight:500; font-size:13px;
                        white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .tile .name span { color:var(--muted); font-size:11.5px; }

        .reel-cell { width:20%; }
        @media (max-width:820px){ .reel-cell{ width:25%; } }
        @media (max-width:620px){ .reel-cell{ width:33.33%; } }
        @media (max-width:420px){ .reel-cell{ width:50%; } }
        .reel { display:block; position:relative; border-radius:14px; overflow:hidden;
                background:#11131a; padding-top:160%; }
        .reel img, .reel video { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; }
        .reel .meta { display:block; position:absolute; left:0; right:0; bottom:0; padding:10px;
                      color:#fff; font-size:12px;
                      background:linear-gradient(to top, rgba(0,0,0,.75), transparent); }

        .chips { margin:0 0 18px 0; }
        .chips a { display:inline-block; border:1px solid var(--line); border-radius:18px;
                   padding:6px 14px; margin:0 6px 8px 0; color:#3b424e; font-size:13px; }
        .chips a.on { background:var(--rose); border-color:var(--rose); color:#fff; }

        .cta { display:inline-block; background:var(--rose); color:#fff; padding:13px 26px;
               border-radius:26px; font-weight:500; }
        .cta:hover { background:#ad1457; text-decoration:none; }

        .pager { margin:26px 0; text-align:center; }
        .pager a, .pager span { display:inline-block; padding:7px 12px; margin:0 2px;
                                border:1px solid var(--line); border-radius:8px; color:#3b424e; font-size:13px; }
        .pager .current { background:var(--rose); border-color:var(--rose); color:#fff; }

        footer.bottom { border-top:1px solid var(--line); margin-top:50px; padding:26px 0 40px 0;
                        color:var(--muted); font-size:13px; }
        footer.bottom a { color:var(--muted); margin-right:16px; }
    </style>
    {% block head %}{% endblock %}
</head>
<body>

<header class="top">
    <div class="wrap">
        <a class="mark" href="{{ path('app_site_home') }}">
            {% if setting.siteLogo %}<img src="{{ setting.siteLogo.remote ? setting.siteLogo.url : asset(setting.siteLogo.link) }}" alt="">{% endif %}
            {{ setting.siteTitle }}
        </a>
        <nav>
            <a href="{{ path('app_site_packs') }}">Sticker packs</a>
            <a href="{{ path('app_site_reels') }}">Reels</a>
            {% if setting.googleplay %}<a class="get" href="{{ setting.googleplay }}" rel="nofollow">Get the app</a>{% endif %}
        </nav>
    </div>
</header>

<main class="wrap">
    {% block body %}{% endblock %}
</main>

<footer class="bottom">
    <div class="wrap">
        <a href="{{ path('app_site_packs') }}">Sticker packs</a>
        <a href="{{ path('app_site_reels') }}">Reels</a>
        <a href="{{ path('app_home_privacypolicy') }}">Privacy policy</a>
        <p style="margin-top:12px;">© {{ "now"|date("Y") }} {{ setting.siteTitle }}</p>
    </div>
</footer>

</body>
</html>
