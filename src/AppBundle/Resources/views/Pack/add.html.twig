{% extends "AppBundle::layout.html.twig" %}
{% block body%}
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-offset-1 col-md-10">
        <div class="card">
          <div class="card-header card-header-icon" data-background-color="rose">
            <i class="material-icons">inbox</i>
          </div>
          <div class="card-content">
            <h4 class="card-title">New Pack</h4>
            {{form_start(form)}}
            <div class="form-group label-floating ">
              <label class="control-label">Pack name</label>
              {{form_widget(form.name,{"attr":{"class":"form-control"}})}}
              <span class="validate-input">{{form_errors(form.name)}}</span>
            </div>
            <div class="form-group label-floating ">
              <label class="control-label">Pack publisher</label>
              {{form_widget(form.publisher,{"attr":{"class":"form-control"}})}}
              <span class="validate-input">{{form_errors(form.publisher)}}</span>
            </div>
            <div class="form-group label-floating ">
              <label class="control-label">Publisher E-mail</label>
              {{form_widget(form.publisheremail,{"attr":{"class":"form-control"}})}}
              <span class="validate-input">{{form_errors(form.publisheremail)}}</span>
            </div>
            <div class="form-group label-floating ">
              <label class="control-label">Publisher Website</label>
              {{form_widget(form.publisherwebsite,{"attr":{"class":"form-control"}})}}
              <span class="validate-input">{{form_errors(form.publisherwebsite)}}</span>
            </div>
            <div class="form-group label-floating ">
              <label class="control-label">Website privacy policy</label>
              {{form_widget(form.privacypolicywebsite,{"attr":{"class":"form-control"}})}}
              <span class="validate-input">{{form_errors(form.privacypolicywebsite)}}</span>
            </div>
            <div class="form-group label-floating ">
              <label class="control-label">Website license agreement</label>
              {{form_widget(form.licenseagreementwebsite,{"attr":{"class":"form-control"}})}}
              <span class="validate-input">{{form_errors(form.licenseagreementwebsite)}}</span>
            </div>
            <br>
            <div class="panel-body">
              <label class="panel-title">Pack infos</label>
              <div class="">
                <label>
                  {{form_widget(form.enabled)}}  Enabled
                </label>
              </div>
              <div class="">
                <label>
                  {{form_widget(form.premium)}}  Premium Pack
                </label>
              </div>
              <div class="">
                <label>
                  {{form_widget(form.animated)}}  Animated
                </label>
              </div>
                            <div class="">
                <label>
                  {{form_widget(form.whatsapp)}}  Enable whatsapp Button
                </label>

                </div>
            </div>
            <div class="panel-body">
              <label class="panel-title">Telegram</label>
              <div class="">
                <label>
                  {{form_widget(form.telegram)}}  Enabled
                </label>
              </div>
              <div class="form-group label-floating ">
                <label class="control-label">Telegram store pack url</label>
                {{form_widget(form.telegramurl,{"attr":{"class":"form-control"}})}}
                <span class="validate-input">{{form_errors(form.telegramurl)}}</span>
              </div>
            </div>
            <div class="panel-body">
              <label class="panel-title">Signal</label>
              <div class="">
                <label>
                  {{form_widget(form.signal)}}  Enabled Signal Button
                </label>
              </div>
              <div class="form-group label-floating ">
                <label class="control-label">Signal store pack url</label>
                {{form_widget(form.signalurl,{"attr":{"class":"form-control"}})}}
                <span class="validate-input">{{form_errors(form.signalurl)}}</span>
              </div>
            </div>
            <br>
            {{form_label(form.categories,null,{label_attr:{"style":"font-size:16px"}})}} :
            <div>
              <div class="row">
                {% for field in form.categories %}
                  <label  style="background: black;border-radius: 3px;padding: 5px;text-align: center;margin: 10px;color: white;font-weight: bold;padding-left: 20px;padding-right: 20px;">
                    {{ form_widget(field) }} {{ field.vars.label }}
                  </label>
                {% endfor %}
              </div>
            </div>
            <br>
            <div class="form-group label-floating ">
              <label class="control-label">Pack tags (Ex:anim,art,hero)</label>
              <br>
              {{form_widget(form.tags,{"attr":{"class":"input-tags"}})}}
              <span class="validate-input">{{form_errors(form.tags)}}</span>
            </div>
            <script>
            $('.input-tags').selectize({
            persist: false,
            createOnBlur: true,
            create: true
            });
            </script>
            <br>
            {# Where the pictures go. The pack image and every sticker follow the same
               choice, so a pack is never split across the server and the Space. #}
            <div class="panel-body">
              <label class="panel-title">Store images in</label>
              <div class="storage-choice">
                {# Looped rather than named: an expanded choice names its children by
                   position, so the value on each one is what says which is which. #}
                {% for choice in form.storage %}
                  {% set is_spaces = choice.vars.value == 'spaces' %}
                  <label class="storage-option{% if is_spaces and not spaces_ready %} storage-option-off{% endif %}">
                    {{ form_widget(choice, (is_spaces and not spaces_ready) ? {"attr":{"disabled":"disabled"}} : {}) }}
                    <span class="storage-name">
                      <i class="material-icons">{{ is_spaces ? 'cloud_upload' : 'storage' }}</i>
                      {{ is_spaces ? 'DigitalOcean Spaces' : 'This server' }}
                    </span>
                    <span class="storage-note">
                      {% if not is_spaces %}
                        The uploads folder, the way packs have always been stored.
                      {% elseif spaces_ready %}
                        The same Space the reels use. Nothing is kept on this server.
                      {% else %}
                        Not set up yet. Add spaces_key, spaces_secret and spaces_bucket to
                        app/config/parameters.yml, then clear app/cache.
                      {% endif %}
                    </span>
                  </label>
                {% endfor %}
              </div>
              <span class="validate-input">{{form_errors(form.storage)}}</span>
            </div>
            <style>
              .storage-choice { display: flex; flex-wrap: wrap; margin: 6px -6px 0 -6px; }
              .storage-option { flex: 1 1 260px; margin: 6px; padding: 14px 16px; cursor: pointer;
                                border: 2px solid #e0e0e0; border-radius: 6px; font-weight: normal; }
              .storage-option.is-picked { border-color: #e91e63; background: #fdf3f6; }
              .storage-option.storage-option-off { opacity: .55; cursor: not-allowed; }
              .storage-option .storage-name { display: block; font-weight: bold; color: #333; }
              .storage-option .storage-name i { font-size: 18px; vertical-align: -4px; margin-right: 4px; }
              .storage-option .storage-note { display: block; margin-top: 4px; font-size: 12px; color: #999; }
              .storage-option input[type="radio"] { margin-right: 6px; }
            </style>
            <script>
              $(function () {
                var $inputs = $('.storage-option input[type="radio"]');
                function paint() {
                  $inputs.each(function () {
                    $(this).closest('.storage-option').toggleClass('is-picked', this.checked);
                  });
                }
                $inputs.on('change', paint);
                paint();
              });
            </script>
            <br>
            <div class="pack-files">
              <div class="pack-image">
                <div class="path-image-img"><img src="{{asset("img/image_placeholder.jpg")}}" class="thumbnail" id="img-preview"></div>
                <button class="btn-select">select pack image</button>
                <div class="form-group label-floating is-input-file">
                  {{form_widget(form.file,{"attr":{"class":"form-control"}})}}
                </div>
              </div>
              <div class="pack-stickers">
                <div class="pack-stickers-files"></div>
                <button class="btn-select-stickers">select stickers files (PNG/WEBP files)</button>
                <div class="form-group label-floating is-input-file">
                  {{form_widget(form.files,{"attr":{"class":"form-control"}})}}
                </div>
              </div>
            </div>
            <span class="validate-input">{{form_errors(form.files)}}</span>
            <span class="validate-input">{{form_errors(form.file)}}</span>
            <span class="pull-right"><a href="{{path("app_pack_index")}}" class="btn btn-fill btn-yellow"><i class="material-icons">arrow_back</i> Cancel</a>{{form_widget(form.save,{attr:{"class":"btn btn-fill btn-rose"}})}}</span>
            {{form_end(form)}}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock%}